# Copy to .env.local for local runs. In Vercel add the same names under Settings > Environment Variables.

# Database (browser-safe publishable key; leave both empty to run on browser-only demo data)
VITE_SUPABASE_URL=https://gxeokcnbrywhhjotbfkv.supabase.co
VITE_SUPABASE_ANON_KEY=

# AI-written questions (server only, never prefix with VITE_). Used by api/generate-questions.js via `vercel dev` or on Vercel.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Signed evidence packs (server only). Ed25519 private key, PKCS#8 DER, base64. Its public half goes in
# src/data/evidenceKey.js. See README > Configuration for a one-line generator.
EVIDENCE_SIGNING_KEY=

# Model-registry connector (server only). 32 random bytes, base64. Encrypts clients' registry tokens.
CONNECTOR_KEY=
